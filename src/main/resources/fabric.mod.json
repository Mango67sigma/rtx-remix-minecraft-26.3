{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft",
    "description": "Renders Minecraft through NVIDIA RTX Remix path tracing. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT. Unofficial community port to Minecraft 26.3, not affiliated with or endorsed by NVIDIA.",
    "authors": [
        "NVIDIA"
    ],
    "contact": {
        "homepage": "https://github.com/Mango67sigma/rtx-remix-minecraft-26.3",
        "sources": "https://github.com/Mango67sigma/rtx-remix-minecraft-26.3",
        "issues": "https://github.com/Mango67sigma/rtx-remix-minecraft-26.3/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.20.1",
        "fabric-api": ">=0.165.0+26.3",
        "minecraft": "26.3",
        "java": ">=25"
    }
}
